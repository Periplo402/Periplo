{
  "name": "periplo",
  "private": true,
  "version": "0.0.0",
  "description": "Discovery layer for x402-payable services on Stellar.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "typecheck": "tsc -b --pretty",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "licence-check": "tsx packages/licence-check/src/cli.ts",
    "eval": "tsx eval/run.ts",
    "verify-evidence": "tsx packages/evidence-check/src/cli.ts",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm licence-check && pnpm audit --prod"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "26.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
